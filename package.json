{
  "name": "quadcodeguide",
  "version": "1.0.0",
  "private": true,
  "description": "Quadcode Guide site + publish API",
  "scripts": {
    "dev": "node scripts/dev_server.mjs",
    "publish-case": "node scripts/publish_case.mjs",
    "media:check": "node scripts/normalize_media.mjs --check",
    "media:dry": "node scripts/normalize_media.mjs --dry",
    "media:apply": "node scripts/normalize_media.mjs --apply",
    "migrate-videos": "node scripts/migrate_assets_to_blob.mjs",
    "migrate-videos:dry": "node scripts/migrate_assets_to_blob.mjs --dry-run",
    "migrate-direct": "node scripts/migrate_direct_blob.mjs",
    "migrate-direct:dry": "node scripts/migrate_direct_blob.mjs --dry-run",
    "build-project": "node scripts/build_guide_project.mjs",
    "build-project:dry": "node scripts/build_guide_project.mjs jerry01-quadcode-testimonials --dry-run",
    "import-21st": "node scripts/import_21st_guides.mjs --limit 15",
    "import-21st:publish": "node scripts/import_21st_guides.mjs --limit 15 --publish"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.3"
  }
}
